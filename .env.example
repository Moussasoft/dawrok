# Copier ce fichier en `.env` puis renseigner les valeurs.

# Base de données (SQLite en dev ; PostgreSQL recommandé en prod)
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions — OBLIGATOIRE en production.
# Au moins 32 caractères aléatoires : `openssl rand -base64 48`
JWT_SECRET=""

# URL publique de l'application (utilisée dans les QR codes et les notifications)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notifications push (optionnel) — générer avec : npx web-push generate-vapid-keys
# Sans ces clés, le bouton « Me notifier » se limite aux notifications de l'onglet ouvert.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@example.com"

# E-mails transactionnels (mot de passe oublié, invitations) — l'un OU l'autre.
# Sans fournisseur : les e-mails s'affichent dans la console en développement.
# SMTP_URL="smtps://utilisateur:motdepasse@smtp.example.com:465"
# RESEND_API_KEY=""
# MAIL_FROM="Daourak <no-reply@votre-domaine.ma>"

# Derrière un proxy : nombre de proxys de confiance (lecture de l'IP réelle pour le rate limiting)
# TRUSTED_PROXY_HOPS=1
# Mettre à 1 uniquement si votre proxy écrase TOUJOURS l'en-tête X-Real-IP (ex. Nginx : proxy_set_header X-Real-IP $remote_addr)
# TRUST_X_REAL_IP=0

# Mentions légales (politique de confidentialité, conditions d'utilisation — loi 09-08)
# LEGAL_COMPANY_NAME="Votre société SARL"
# LEGAL_CONTACT_EMAIL="privacy@votre-domaine.ma"
# LEGAL_ADDRESS="Adresse du siège"
# Numéro de déclaration / d'autorisation CNDP, affiché dans la politique s'il est renseigné
# CNDP_DECLARATION=""

# Purge quotidienne des données expirées : planifiée dans le serveur Node par défaut.
# Sur une plateforme sans processus permanent (serverless) : RETENTION_SCHEDULER=off et un cron
# qui appelle GET /api/cron/retention avec l'en-tête « Authorization: Bearer $CRON_SECRET ».
# RETENTION_SCHEDULER=off
# CRON_SECRET=""
