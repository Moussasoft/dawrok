// Prisma schema — Daourak SaaS queue management
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =========================================================
// Tenants & Auth
// =========================================================
model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  sector     String   @default("other") // hairdresser | doctor | vehicle_inspection | bank | restaurant | other
  plan       String   @default("free")  // free | starter | pro | business
  brandColor String   @default("#6366F1")
  logoUrl    String?  // /api/orgs/{id}/logo?v=… (versionnée pour le cache)
  suspended  Boolean  @default(false)
  // Loi 09-08 : au-delà, tickets anonymisés et fiches clients inactives supprimées (purge quotidienne).
  retentionDays Int   @default(365)
  // Prévenir par SMS ou WhatsApp les clients qui l'ont demandé (dans le quota de l'offre).
  smsEnabled Boolean  @default(false)
  smsChannel String   @default("sms") // sms | whatsapp
  // Abonnement payant (Stripe) : l'offre suit l'abonnement, synchronisée par webhook.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  billingStatus        String?   // active | trialing | past_due | canceled | incomplete…
  planRenewsAt         DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branches    Branch[]
  users       User[]
  invitations Invitation[]
  logo        OrgLogo?
  smsMessages SmsMessage[]
}

// Logo redimensionné (WebP), stocké en base (portable, sans disque partagé) mais dans sa propre
// table : charger une organisation (à chaque requête authentifiée) ne charge pas l'image.
model OrgLogo {
  orgId     String   @id
  data      Bytes
  mime      String
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("owner") // owner (tout) | manager (file, analytics, réglages) | staff (file)
  isSuperadmin Boolean  @default(false)
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  // Toute session émise avant ce moment est refusée (mot de passe changé ou réinitialisé).
  passwordChangedAt DateTime?
  // Acceptation des conditions d'utilisation et de la politique de confidentialité.
  termsAcceptedAt   DateTime?

  passwordResetTokens PasswordResetToken[]

  @@index([orgId])
}

// Invitation d'un membre d'équipe : lien à usage unique (hash stocké), valable 7 jours.
model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        String    @default("staff")
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// Lien « mot de passe oublié » : seul le hash du jeton est stocké, usage unique, 1 h.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =========================================================
// Locations & Resources
// =========================================================
model Branch {
  id            String    @id @default(cuid())
  orgId         String
  name          String
  address       String?
  qrToken       String    @unique @default(cuid()) // public token used in QR URL
  timezone      String    @default("Africa/Casablanca")
  active        Boolean   @default(true)
  // Pause/closure
  closedUntil   DateTime? // queue paused until this date (null = open)
  closureReason String?
  // Opening hours (simple JSON: { mon:{open:"09:00",close:"19:00"}, ... })
  openHours     String?   // JSON
  // Allow advance booking
  allowBooking  Boolean   @default(true)
  bookingSlotMin Int      @default(15) // slot granularity
  createdAt     DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  services     Service[]
  employees    Employee[]
  tickets      Ticket[]
  customers    Customer[]
  auditLogs    AuditLog[]
  counters     DailyCounter[]
  feedbacks    Feedback[]

  @@index([orgId])
}

model Service {
  id            String  @id @default(cuid())
  branchId      String
  name          String
  avgDurationMin Int    @default(20)
  color         String  @default("#6366F1")
  active        Boolean @default(true)

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([branchId])
}

model Employee {
  id        String  @id @default(cuid())
  branchId  String
  name      String
  active    Boolean @default(true)

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([branchId])
}

// =========================================================
// Queue
// =========================================================
model Ticket {
  id           String   @id @default(cuid())
  branchId    String
  number       Int      // sequential per branch per day
  publicCode   String   @unique @default(cuid()) // for client live URL
  customerName String
  customerPhone String?
  customerId   String?  // linked Customer for history
  serviceId    String?
  employeeId   String?
  status       String   @default("waiting") // scheduled | waiting | called | in_progress | done | no_show | cancelled
  priority     Int      @default(0)        // 1 = RDV arrivé à échéance (passe en tête de file)
  recallCount  Int      @default(0)        // nombre de rappels (ré-annonce TV + notification)
  kind         String   @default("walkin")  // walkin | appointment
  scheduledFor DateTime? // for advance bookings
  cancelToken  String?  @unique             // token allowing public cancel via /api/tickets/cancel/[token]
  locale       String   @default("ar")      // langue du client (SMS, e-mails)
  notifySms    Boolean  @default(false)     // consentement : prévenir par SMS / WhatsApp
  smsSoonAt    DateTime?                    // dédoublonnage des SMS « bientôt votre tour »
  smsCalledAt  DateTime?                    // … et « c'est votre tour » (premier appel seulement)

  createdAt    DateTime @default(now())
  calledAt     DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  pushSubscriptions PushSubscription[]
  feedback Feedback?

  @@index([branchId, status])
  @@index([branchId, createdAt])
  @@index([branchId, scheduledFor])
  @@index([customerId])
}

// SMS / WhatsApp envoyés : quota mensuel de l'offre et suivi des coûts (sans le numéro du client).
model SmsMessage {
  id         String   @id @default(cuid())
  orgId      String
  ticketId   String?
  channel    String   // sms | whatsapp
  kind       String   // soon | called
  status     String   // sent | failed
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// Numérotation atomique : un compteur par agence et par jour local (fuseau de l'agence).
model DailyCounter {
  branchId String
  day      String // AAAA-MM-JJ
  value    Int    @default(0)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([branchId, day])
}

// Abonnements Web Push d'un client pour suivre son ticket écran verrouillé.
model PushSubscription {
  id        String   @id @default(cuid())
  ticketId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("ar")
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// Avis du client après son passage : un seul par ticket, possible pendant 7 jours.
model Feedback {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  branchId  String
  rating    Int      // 1 à 5
  comment   String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
}

// =========================================================
// Customer fidelity (per branch)
// =========================================================
model Customer {
  id           String    @id @default(cuid())
  branchId     String
  phone        String
  name         String
  totalVisits  Int       @default(0)
  noShowCount  Int       @default(0)
  lastVisitAt  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([branchId, phone])
  @@index([branchId])
}

// =========================================================
// Audit log (superadmin + org actions)
// =========================================================
model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  branchId   String?
  actorId    String?  // userId who performed the action
  actorName  String?
  actorEmail String?
  isSuperadmin Boolean @default(false)
  action     String   // e.g. "org.suspend", "org.delete", "impersonate.start", "ticket.cancel", "branch.close"
  targetType String?  // org | user | ticket | branch
  targetId   String?
  metadata   String?  // JSON
  createdAt  DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([action, createdAt])
}

// =========================================================
// Superadmin configuration
// =========================================================

// Limits & features per plan (editable by superadmin)
model PlanConfig {
  id               String   @id @default(cuid())
  plan             String   @unique // free | starter | pro | business
  price            Int      @default(0)     // monthly price in currency units
  maxBranches      Int      @default(1)
  maxEmployees     Int      @default(3)
  maxServices      Int      @default(5)
  allowBooking     Boolean  @default(false)
  allowAnalytics   Boolean  @default(false)
  allowCustomBrand Boolean  @default(false)
  smsQuota         Int      @default(0)     // SMS / WhatsApp inclus par mois (0 = non inclus)
  updatedAt        DateTime @updatedAt
}

// Generic key-value store for system configuration (notifications, etc.)
model SystemConfig {
  key       String   @id
  value     String   // JSON
  updatedAt DateTime @updatedAt
}
